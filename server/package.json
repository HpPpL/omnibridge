{
  "name": "omnibridge-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Backend pipeline for OmniBridge: poll sources, normalize, deliver to destinations.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "dialogs": "node --experimental-sqlite --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import tsx src/commands/list-dialogs.ts",
    "vk-auth": "node --env-file-if-exists=.env --import tsx src/commands/vk-auth.ts",
    "vk-token": "node --env-file-if-exists=.env --import tsx src/commands/vk-token.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
