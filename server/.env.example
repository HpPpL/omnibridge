# ── Источник: ЛИЧНЫЙ аккаунт ВКонтакте (личные сообщения) ──
# User-токен с правами messages. Получить — `npm run vk-token -- --app <APP_ID>`.
VK_USER_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxx
# id твоего Standalone-приложения VK (для ловца токена vk-token).
VK_APP_ID=
# Выбранные диалоги (peer_id через запятую). Узнать id — командой `npm run dialogs`.
VK_DIALOGS=
# Сколько диалогов тянуть в discovery.
VK_DIALOGS_LIMIT=50
# Путь к SQLite-хранилищу.
DB_PATH=omnibridge.db
# Мок-режим: 1 = фейковые диалоги/история без токена и сети (для отладки).
VK_MOCK=
# Сколько тестовых «новых» сообщений эмитит мок live и с каким интервалом.
VK_MOCK_LIVE_COUNT=3
VK_MOCK_LIVE_INTERVAL_MS=1200

# ── Источник: СООБЩЕСТВО ВКонтакте (bots long poll) ──
# ID сообщества (Управление → Настройки → ...; число).
VK_GROUP_ID=123456789
# Ключ доступа сообщества с правами на сообщения.
VK_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxx

# ── Назначение: Telegram-бот ────────────────────────
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz
# Куда пересылать: id чата/канала (бот должен быть участником).
TELEGRAM_CHAT_ID=-1001234567890

# Порт health-эндпоинта.
PORT=8787
