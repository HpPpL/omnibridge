# ── Источник: сообщество ВКонтакте ──────────────────
# ID сообщества (Управление → Настройки → ...; число).
VK_GROUP_ID=123456789
# Ключ доступа сообщества с правами на сообщения (Long Poll API включить в настройках).
VK_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxx

# ── Назначение: Telegram-бот ────────────────────────
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz
# Куда пересылать: id чата/канала (бот должен быть участником).
TELEGRAM_CHAT_ID=-1001234567890

# Порт health-эндпоинта.
PORT=8787
